# caddy.service — config-file unit (IT-DW build)
#
# Runs cert-sanity before start to drop cert/key pairs whose public keys
# do not match, then loads /etc/caddy/Caddyfile.

[Unit]
Description=Caddy (IT-DW)
Documentation=https://caddyserver.com/docs/
Documentation=https://github.com/itdwgmbh/caddy
After=network.target network-online.target
Requires=network-online.target

[Service]
Type=notify
User=caddy
Group=caddy
Environment=XDG_DATA_HOME=/var/lib/caddy
Environment=XDG_CONFIG_HOME=/var/lib/caddy
Environment=CADDY_CERT_ROOT=/var/lib/caddy/caddy/certificates
ExecStartPre=/usr/bin/cert-sanity
ExecStart=/usr/bin/caddy run --environ --config /etc/caddy/Caddyfile
ExecReload=/usr/bin/caddy reload --config /etc/caddy/Caddyfile --force
TimeoutStopSec=5s
LimitNOFILE=1048576

# Capabilities: low ports only (CAP_NET_ADMIN not required)
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE

# Filesystem sandbox
ProtectSystem=strict
ReadWritePaths=/var/lib/caddy /var/log/caddy
PrivateTmp=true
ProtectHome=true
PrivateDevices=true

# Kernel / privilege surface
NoNewPrivileges=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
RestrictSUIDSGID=true
LockPersonality=true
RestrictRealtime=true
RestrictNamespaces=true
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
