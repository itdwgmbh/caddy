# caddy-api.service — API/resume unit (IT-DW build)

[Unit]
Description=Caddy (IT-DW, API)
Documentation=https://caddyserver.com/docs/
Documentation=https://github.com/itdwgmbh/caddy
After=network.target network-online.target
Requires=network-online.target

[Service]
Type=notify
User=caddy
Group=caddy
Environment=XDG_DATA_HOME=/var/lib/caddy
Environment=XDG_CONFIG_HOME=/var/lib/caddy
Environment=CADDY_CERT_ROOT=/var/lib/caddy/caddy/certificates
ExecStartPre=/usr/bin/cert-sanity
ExecStart=/usr/bin/caddy run --environ --resume
TimeoutStopSec=5s
LimitNOFILE=1048576
PrivateTmp=true
ProtectSystem=full
AmbientCapabilities=CAP_NET_ADMIN CAP_NET_BIND_SERVICE

[Install]
WantedBy=multi-user.target
